# ChronoSpectrum Engine — .gitignore
# Monorepo: frontend/ (Node + Vite + TS) y backend/ (Python + uv)

## --- Frontend (Node / Vite / TypeScript) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/coverage/

## Logs de npm/pnpm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

## --- Backend (Python / uv / FastAPI) ---
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
backend/*.egg-info/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/

## uv (se versiona uv.lock, no el entorno)
backend/.python-version

## --- Variables de entorno / secretos ---
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env

## --- Editores / SO ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

## --- Otros artefactos temporales ---
*.log
*.tmp

## --- Notas internas (no se suben al repo) ---
ROADMAP.md
